{
  "version": 2,
  "purpose": "Operational catalog for external browser fingerprint tests.",
  "defaultWaitMs": 15000,
  "tests": [
    {
      "id": "pixelscan",
      "group": "core",
      "url": "https://pixelscan.net/fingerprint-check",
      "status": "mapped",
      "run": {
        "type": "auto",
        "waitMs": 30000
      },
      "read": [
        "pixelscan-main-heading",
        "pixelscan-verdict",
        "pixelscan-browser-card",
        "pixelscan-location-card",
        "pixelscan-proxy-card",
        "pixelscan-fingerprint-card",
        "pixelscan-bot-card",
        "pixelscan-ip-address",
        "pixelscan-webrtc-ip-address",
        "pixelscan-country",
        "pixelscan-city",
        "pixelscan-isp",
        "pixelscan-latitude",
        "pixelscan-longitude",
        "pixelscan-user-type-by-ip",
        "pixelscan-timezone-js",
        "pixelscan-time-ip",
        "pixelscan-screen-resolution",
        "pixelscan-font-hash",
        "pixelscan-font-list",
        "pixelscan-user-agent-http",
        "pixelscan-user-agent-js",
        "pixelscan-platform",
        "pixelscan-do-not-track",
        "pixelscan-hardware-concurrency",
        "pixelscan-language-js",
        "pixelscan-intl-api",
        "pixelscan-accept-language",
        "pixelscan-webgl-vendor",
        "pixelscan-webgl-version",
        "pixelscan-webgl-renderer",
        "pixelscan-webgl-hash",
        "pixelscan-canvas-hash",
        "pixelscan-audiocontext-hash"
      ],
      "failureSurfaces": [
        "ua-client-hints",
        "worker-service-worker",
        "screen-workarea",
        "webgl-canvas",
        "webrtc-dns-proxy"
      ]
    },
    {
      "id": "browserscan",
      "group": "core",
      "url": "https://browserscan.org/",
      "status": "mapped",
      "run": {
        "type": "auto",
        "waitMs": 45000
      },
      "read": [
        "risk-assessment",
        "risk-level",
        "ip",
        "geo",
        "webrtc",
        "dns",
        "tls",
        "canvas",
        "webgl",
        "screen",
        "hardware",
        "fonts"
      ],
      "failureSurfaces": [
        "trust-score",
        "proxy-reputation",
        "webrtc-dns-proxy",
        "tls-ua-mismatch",
        "hardware-fingerprint"
      ]
    },
    {
      "id": "iphey",
      "group": "core",
      "url": "https://iphey.com/",
      "status": "mapped",
      "run": {
        "type": "auto",
        "waitMs": 45000
      },
      "read": [
        "trust-status",
        "ip",
        "location",
        "hardware",
        "software",
        "fonts",
        "plugins",
        "behavior",
        "vpn-proxy"
      ],
      "failureSurfaces": [
        "ip-location",
        "timezone-language",
        "proxy-vpn",
        "bot-behavior",
        "rare-browser-profile"
      ]
    },
    {
      "id": "printleaks",
      "group": "core",
      "url": "https://www.printleaks.com/",
      "status": "mapped",
      "run": {
        "type": "click-if-present",
        "selectorHints": [
          "button",
          "input[type=submit]"
        ],
        "waitMs": 45000
      },
      "read": [
        "webgl",
        "audio-context",
        "fonts",
        "screen",
        "cpu-gpu",
        "webrtc",
        "navigator",
        "permissions",
        "plugins",
        "storage"
      ],
      "failureSurfaces": [
        "webgl-audio-canvas",
        "font-set",
        "navigator-permissions",
        "webrtc-policy",
        "hardware-profile"
      ]
    },
    {
      "id": "creepjs",
      "group": "core",
      "url": "https://abrahamjuliot.github.io/creepjs/",
      "status": "mapped",
      "run": {
        "type": "auto",
        "waitText": "FP ID",
        "waitMs": 20000
      },
      "read": [
        "lies",
        "bold-fail",
        "webrtc",
        "timezone",
        "intl",
        "headless",
        "worker",
        "webgl",
        "screen",
        "canvas2d",
        "fonts",
        "audio",
        "speech",
        "css-media",
        "navigator",
